import { db } from "./firebase.js";
import {
  collection,
  query,
  orderBy,
  getDocs
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";

const postsRef = collection(db, "posts");

function escapeHTML(value = "") {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function renderNews(item) {
  const data = item.data;
  return `
    <article class="glass rounded-2xl overflow-hidden hover:border-green-400/30 transition">
      <div class="relative overflow-hidden">
        <img src="${escapeHTML(data.image || "")}"
             alt="${escapeHTML(data.title || "News")}"
             class="w-full h-48 object-cover"
             loading="lazy">
        <span class="absolute top-3 left-3 bg-green-500 text-black text-[10px] font-black px-2.5 py-1 rounded-md">
          ${escapeHTML(data.category || "NEWS")}
        </span>
      </div>
      <div class="p-4">
        <h3 class="font-bold leading-6">${escapeHTML(data.title || "Football News")}</h3>
        <p class="text-xs text-gray-500 mt-2 line-clamp-2">${escapeHTML(data.content || "")}</p>
      </div>
    </article>
  `;
}

function renderVideo(item) {
  const data = item.data;
  const youtubeId = data.youtubeId || "";
  const thumbnail = data.thumbnailUrl || data.image ||
    (youtubeId ? `https://img.youtube.com/vi/${encodeURIComponent(youtubeId)}/hqdefault.jpg` : "");

  return `
    <article class="glass rounded-2xl overflow-hidden hover:border-red-400/30 transition">
      <button type="button"
        class="home-video-trigger w-full text-left"
        data-youtube-id="${escapeHTML(youtubeId)}"
        data-title="${escapeHTML(data.title || "Football Video")}">
        <div class="relative">
          <img src="${escapeHTML(thumbnail)}"
               alt="${escapeHTML(data.title || "Football Video")}"
               class="w-full h-52 object-cover"
               loading="lazy">
          <div class="absolute inset-0 flex items-center justify-center bg-black/10">
            <div class="w-14 h-14 rounded-full bg-red-600 flex items-center justify-center text-white">
              <i class="fa-solid fa-play"></i>
            </div>
          </div>
        </div>
      </button>
      <div class="p-4">
        <h3 class="font-bold line-clamp-2">${escapeHTML(data.title || "Football Video")}</h3>
        <p class="text-xs text-gray-500 mt-2">${escapeHTML(data.category || "VIDEO")}</p>
      </div>
    </article>
  `;
}

async function loadHomeSections() {
  try {
    const snapshot = await getDocs(
      query(postsRef, orderBy("createdAt", "desc"))
    );

    const posts = snapshot.docs.map(doc => ({
      id: doc.id,
      data: doc.data()
    }));

    const news = posts
      .filter(item => item.data.type === "news")
      .slice(0, 6);

    const videos = posts
      .filter(item => item.data.type === "video")
      .slice(0, 4);

    const highlights = posts
      .filter(item =>
        item.data.type === "video" &&
        item.data.category === "highlights"
      )
      .slice(0, 5);

    const newsContainer = document.getElementById("homeLatestNews");
    const videosContainer = document.getElementById("homeLatestVideos");
    const highlightsContainer = document.getElementById("homeHighlights");

    if (newsContainer) {
      newsContainer.innerHTML = news.length
        ? news.map(renderNews).join("")
        : `<div class="glass rounded-2xl p-8 text-center text-gray-500 md:col-span-4">No news yet.</div>`;
    }

    if (videosContainer) {
      videosContainer.innerHTML = videos.length
        ? videos.map(renderVideo).join("")
        : `<div class="glass rounded-2xl p-8 text-center text-gray-500 md:col-span-3">No videos yet.</div>`;
    }

    if (highlightsContainer) {
      highlightsContainer.innerHTML = highlights.length
        ? highlights.map(renderVideo).join("")
        : `<div class="glass rounded-2xl p-8 text-center text-gray-500 md:col-span-3">No highlights yet.</div>`;
    }

    document.querySelectorAll(".home-video-trigger").forEach(button => {
      button.addEventListener("click", () => {
        const youtubeId = button.dataset.youtubeId;
        const title = button.dataset.title || "Football Video";
        if (youtubeId && window.FootballXtraMiniPlayer) {
          window.FootballXtraMiniPlayer.play(youtubeId, title);
        }
      });
    });

    console.log(
      `Homepage sections loaded: news=${news.length}, videos=${videos.length}, highlights=${highlights.length}`
    );
  } catch (error) {
    console.error("Homepage sections error:", error);
  }
}

loadHomeSections();
