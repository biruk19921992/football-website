async function loadHomeSections() {
  try {
    const snapshot = await getDocs(
      query(postsRef, orderBy("createdAt", "desc"))
    );

    const posts = snapshot.docs.map(doc => ({
      id: doc.id,
      data: doc.data()
    }));

    const news = posts
      .filter(item => item.data.type === "news")
      .slice(0, 6);

    const videos = posts
      .filter(item => item.data.type === "video")
      .slice(0, 4);

    const highlights = posts
      .filter(item =>
        item.data.type === "video" &&
        item.data.category === "highlights"
      )
      .slice(0, 5);

    const newsContainer = document.getElementById("homeLatestNews");
    const videosContainer = document.getElementById("homeLatestVideos");
    const highlightsContainer = document.getElementById("homeHighlights");

    if (newsContainer) {
      newsContainer.innerHTML = news.length
        ? news.map(renderNews).join("")
        : `<div class="glass rounded-2xl p-8 text-center text-gray-500 md:col-span-4">No news yet.</div>`;
    }

    if (videosContainer) {
      videosContainer.innerHTML = videos.length
        ? videos.map(renderVideo).join("")
        : `<div class="glass rounded-2xl p-8 text-center text-gray-500 md:col-span-3">No videos yet.</div>`;
    }

    if (highlightsContainer) {
      highlightsContainer.innerHTML = highlights.length
        ? highlights.map(renderVideo).join("")
        : `<div class="glass rounded-2xl p-8 text-center text-gray-500 md:col-span-3">No highlights yet.</div>`;
    }

    document.querySelectorAll(".home-video-trigger").forEach(button => {
      button.addEventListener("click", () => {
        const youtubeId = button.dataset.youtubeId;
        const title = button.dataset.title || "Football Video";
        if (youtubeId && window.FootballXtraMiniPlayer) {
          window.FootballXtraMiniPlayer.play(youtubeId, title);
        }
      });
    });

    console.log("🔥 HOME SECTIONS REACHED"); console.log(
      `Homepage sections loaded: news=${news.length}, videos=${videos.length}, highlights=${highlights.length}`
    );
  } catch (error) {
    console.error("Homepage sections error:", error);
  }
}


document.addEventListener("click", async (event) => {
  const button = event.target.closest(".home-action");
  if (!button) return;

  const action = button.dataset.action;
  const id = button.dataset.id;

  if (action === "like") {
    const user = auth.currentUser;

    if (!user) {
      alert("Like ለማድረግ Login ያድርጉ።");
      return;
    }

    const icon = button.querySelector("i");
    const countEl = button.querySelector(".like-count");
    const currentCount = Number(countEl?.textContent || 0);
    const likeRef = doc(db, "posts", id, "likes", user.uid);
    const postRef = doc(db, "posts", id);

    try {
      const existing = await getDoc(likeRef);

      if (existing.exists()) {
        await deleteDoc(likeRef);
        await updateDoc(postRef, {
          likesCount: increment(-1)
        });

        if (countEl) {
          countEl.textContent = String(Math.max(0, currentCount - 1));
        }

        button.classList.remove("text-red-400");
        icon.classList.remove("fa-solid");
        icon.classList.add("fa-regular");
      } else {
        await setDoc(likeRef, {
          uid: user.uid,
          createdAt: serverTimestamp()
        });

        await updateDoc(postRef, {
          likesCount: increment(1)
        });

        if (countEl) {
          countEl.textContent = String(currentCount + 1);
        }

        button.classList.add("text-red-400");
        icon.classList.remove("fa-regular");
        icon.classList.add("fa-solid");
      }

      console.log("❤️ Like updated:", id);
    } catch (error) {
      console.error("❌ Like update failed:", error);
      alert("Like ማስቀመጥ አልተቻለም።");
    }

    return;
  }

  if (action === "comment") {
    const user = auth.currentUser;

    if (!user) {
      alert("Comment ለማድረግ Login ያድርጉ።");
      return;
    }

    const card = button.closest("article");
    const area = card?.querySelector(".comments-area");

    if (!area) return;

    area.classList.toggle("hidden");

    if (!area.classList.contains("hidden")) {
      const list = area.querySelector(".comments-list");

      if (list && id && !id.startsWith("demo-")) {
        try {
          const commentsQuery = query(
            collection(db, "posts", id, "comments"),
            orderBy("createdAt", "asc"),
            limit(50)
          );

          const snapshot = await getDocs(commentsQuery);

          if (snapshot.empty) {
            list.innerHTML =
              '<div class="text-xs text-gray-500 text-center py-2">No comments yet.</div>';
          } else {
            list.innerHTML = snapshot.docs.map(item => {
              const comment = item.data();

              return `
                <div class="flex gap-2 items-start">
                  <div class="w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center text-xs font-bold text-green-400">
                    ${escapeHTML((comment.userName || "U").charAt(0).toUpperCase())}
                  </div>

                  <div class="flex-1 min-w-0 bg-white/5 rounded-xl px-3 py-2">
                    <span class="text-xs font-bold text-white">
                      ${escapeHTML(comment.userName || "User")}
                    </span>
                    <p class="text-sm text-gray-300 mt-1 break-words">
                      ${escapeHTML(comment.text || "")}
                    </p>
                  </div>
                </div>
              `;
            }).join("");
          }
        } catch (error) {
          console.error("❌ Comments loading failed:", error);
          list.innerHTML =
            '<div class="text-xs text-red-400 text-center py-2">Could not load comments.</div>';
        }
      }
    }

    return;
  }

  if (action === "repost") {
    const user = auth.currentUser;

    if (!user) {
      alert("Repost ለማድረግ Login ያድርጉ።");
      return;
    }

    if (id.startsWith("demo-")) {
      alert("Demo post ላይ Repost መቀመጥ አይችልም።");
      return;
    }

    const repostRef = doc(db, "posts", id, "reposts", user.uid);
    const postRef = doc(db, "posts", id);

    try {
      const existing = await getDoc(repostRef);

      if (existing.exists()) {
        alert("ይህን post አስቀድመው Repost አድርገዋል 🔁");
        return;
      }

      await setDoc(repostRef, {
        uid: user.uid,
        createdAt: serverTimestamp()
      });

      await updateDoc(postRef, {
        repostsCount: increment(1)
      });

      button.classList.add("text-green-400");

      const repostCountEl = button.querySelector(".repost-count");
      if (repostCountEl) {
        repostCountEl.textContent =
          String(Number(repostCountEl.textContent || 0) + 1);
      }

      alert("Reposted 🔁");
      console.log("🔁 Repost saved:", id);
    } catch (error) {
      console.error("❌ Repost failed:", error);
      alert("Repost ማድረግ አልተቻለም።");
    }

    return;
  }

  if (action === "share") {
    const url = `${window.location.origin}/index.html#post-${id}`;

    try {
      if (navigator.share) {
        await navigator.share({
          title: "FootballXtra",
          text: "Check this football post ⚽",
          url: url
        });

        if (!id.startsWith("demo-")) {
          await updateDoc(doc(db, "posts", id), {
            sharesCount: increment(1)
          });

          const countEl = button.querySelector(".share-count");
          if (countEl) {
            countEl.textContent =
              String(Number(countEl.textContent || 0) + 1);
          }
        }

        console.log("📤 Share successful:", id);
      } else if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(url);

        if (!id.startsWith("demo-")) {
          await updateDoc(doc(db, "posts", id), {
            sharesCount: increment(1)
          });

          const countEl = button.querySelector(".share-count");
          if (countEl) {
            countEl.textContent =
              String(Number(countEl.textContent || 0) + 1);
          }
        }

        alert("Post link copied! 🔗");
      } else {
        const input = document.createElement("input");
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        input.remove();
        alert("Post link copied! 🔗");
      }
    } catch (error) {
      console.error("❌ Share failed:", error);

      try {
        if (navigator.clipboard) {
          await navigator.clipboard.writeText(url);
          alert("Share unavailable. Link copied! 🔗");
        } else {
          alert("Share unavailable. Link: " + url);
        }
      } catch (fallbackError) {
        alert("Share unavailable. Link: " + url);
      }
    }

    return;
  }
});


document.addEventListener("click", async (event) => {
  const button = event.target.closest(".submit-comment");
  if (!button) return;

  const user = auth.currentUser;

  if (!user) {
    alert("Comment ለመላክ Login ያድርጉ።");
    return;
  }

  const id = button.dataset.id;
  const card = button.closest("article");
  const input = card?.querySelector(".comment-input");
  const text = input?.value.trim();

  if (!id || !text) return;

  if (id.startsWith("demo-")) {
    alert("Demo post ላይ comment መቀመጥ አይችልም።");
    return;
  }

  button.disabled = true;

  try {
    await addDoc(
      collection(db, "posts", id, "comments"),
      {
        uid: user.uid,
        userName: user.displayName || "User",
        userPhoto: user.photoURL || "",
        text,
        createdAt: serverTimestamp()
      }
    );

    await updateDoc(doc(db, "posts", id), {
      commentsCount: increment(1)
    });

    input.value = "";

    console.log("💬 Comment saved:", id);

    const commentButton = card.querySelector('[data-action="comment"]');
    if (commentButton) {
      const oldCount = commentButton.querySelector(".comment-count");

      if (oldCount) {
        oldCount.textContent =
          String(Number(oldCount.textContent || 0) + 1);
      }
    }

    alert("Comment ተልኳል 💬");
  } catch (error) {
    console.error("❌ Comment save failed:", error);
    alert("Comment መላክ አልተቻለም።");
  } finally {
    button.disabled = false;
  }
});

loadHomeSections();
