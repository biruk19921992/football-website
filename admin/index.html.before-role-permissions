onAuthStateChanged(auth, async user => {

  if (!user) {

    window.location.href = "../login.html";

    return;
  }


  try {

    const snap =
      await getDoc(
        doc(db, "users", user.uid)
      );

    if (!snap.exists()) {

      alert("Admin profile not found.");

      await signOut(auth);

      window.location.href = "../login.html";

      return;
    }


    const profile = snap.data();

    const role =
      profile.role || "user";


    const adminRoles = [
      "super_admin",
      "content_admin",
      "video_admin",
      "match_admin",
      "moderator_admin"
    ];


    if (!adminRoles.includes(role)) {

      alert("You don't have admin permission.");

      window.location.href = "../index.html";

      return;
    }


    document.getElementById("adminName")
      .textContent =
      profile.name ||
      user.displayName ||
      "Admin";


    document.getElementById("adminRole")
      .textContent =
      role.replaceAll("_", " ");


    if (profile.photoURL || user.photoURL) {

      document.getElementById("adminAvatar").src =
        profile.photoURL ||
        user.photoURL;

    }


    await loadStats();

  } catch (error) {

    console.error("Admin initialization error:", error);

  }

});

</script>

