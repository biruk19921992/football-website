<!-- ================= FIREBASE / ADMIN ================= -->

<script type="module">

import { auth, db } from "../js/firebase.js";

import {
  onAuthStateChanged,
  signOut
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
  doc,
  getDoc,
  collection,
  getCountFromServer
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


const pages = {

  dashboard: {
    title: "Dashboard",
    icon: "fa-chart-pie",
    description: "FootballXtra overview and system statistics."
  },

  news: {
    title: "News Management",
    icon: "fa-newspaper",
    description: "Create, edit and manage football news."
  },

  transfers: {
    title: "Transfer Management",
    icon: "fa-right-left",
    description: "Manage transfer news and player movements."
  },

  gallery: {
    title: "Photo Gallery",
    icon: "fa-images",
    description: "Manage football photos and galleries."
  },

  videos: {
    title: "Video Management",
    icon: "fa-video",
    description: "Manage highlights, videos and YouTube content."
  },

  matches: {
    title: "Matches",
    icon: "fa-futbol",
    description: "Create and manage football matches."
  },

  scores: {
    title: "Live Scores",
    icon: "fa-bolt",
    description: "Manage live football scores."
  },

  lineups: {
    title: "Lineups",
    icon: "fa-users",
    description: "Manage team lineups."
  },

  tables: {
    title: "League Tables",
    icon: "fa-ranking-star",
    description: "Manage league standings."
  },

  community: {
    title: "Community",
    icon: "fa-comments",
    description: "Monitor football community posts."
  },

  reports: {
    title: "Reports",
    icon: "fa-flag",
    description: "Review reported content."
  },

  ads: {
    title: "Advertisements",
    icon: "fa-rectangle-ad",
    description: "Manage website advertising."
  },

  sponsors: {
    title: "Sponsors",
    icon: "fa-handshake",
    description: "Manage sponsorship campaigns."
  },

  premium: {
    title: "Premium",
    icon: "fa-crown",
    description: "Manage premium memberships."
  },

  revenue: {
    title: "Revenue",
    icon: "fa-money-bill-trend-up",
    description: "View platform monetization and revenue."
  },

  admins: {
    title: "Admin Users",
    icon: "fa-user-shield",
    description: "Manage FootballXtra administrators."
  },

  permissions: {
    title: "Roles & Permissions",
    icon: "fa-key",
    description: "Configure administrator permissions."
  },

  settings: {
    title: "Settings",
    icon: "fa-gear",
    description: "Manage FootballXtra system settings."
  }

};


function showPage(page) {

  const data = pages[page];

  if (!data) return;

  document.querySelectorAll(".nav-item")
    .forEach(el => el.classList.remove("active"));

  document.querySelectorAll(`[data-page="${page}"]`)
    .forEach(el => {
      if (el.classList.contains("nav-item")) {
        el.classList.add("active");
      }
    });

  document.getElementById("pageTitle").textContent = data.title;

  const dashboard =
    document.getElementById("dashboardPage");

  const module =
    document.getElementById("modulePage");

  if (page === "dashboard") {

    dashboard.classList.remove("hidden");
    module.classList.add("hidden");

    return;
  }

  if (page === "admins") {
    dashboard.classList.add("hidden");
    module.classList.remove("hidden");
    document.getElementById("moduleTitle").textContent = data.title;
    document.getElementById("moduleDescription").textContent = data.description;
    document.getElementById("moduleIcon").innerHTML = `<i class="fa-solid ${data.icon}"></i>`;
    const content = document.getElementById("moduleContent");
    content.innerHTML = `<div class="glass rounded-2xl p-6 text-center text-gray-400">Loading Admin Users...</div>`;
    import("/admin/js/modules/admins.js")
      .then(module => module.renderAdminsModule(content))
      .catch(error => {
        console.error("Admins module error:", error);
        content.innerHTML = `<div class="glass rounded-2xl p-8 text-center text-red-400">Failed to load Admin Users module<div class="text-xs text-gray-500 mt-2">${error.message}</div></div>`;
      });
    return;
  }

  if (page === "news") {

    dashboard.classList.add("hidden");
    module.classList.remove("hidden");

    document.getElementById("moduleTitle")
      .textContent = data.title;

    document.getElementById("moduleDescription")
      .textContent = data.description;

    document.getElementById("moduleIcon").innerHTML =
      `<i class="fa-solid ${data.icon}"></i>`;

    const content =
      document.getElementById("moduleContent");

    content.innerHTML = "";

    import("/admin/js/modules/news.js")
      .then(module => module.renderNewsModule(content))
      .catch(error => {

        console.error(error);

        content.innerHTML = `
          <div class="glass rounded-2xl p-8 text-center text-red-400">
            Failed to load News module.
          </div>
        `;

      });

    return;
  }


  if (page === "ads") {
    dashboard.classList.add("hidden");
    module.classList.remove("hidden");
    document.getElementById("moduleTitle").textContent = data.title;
    document.getElementById("moduleDescription").textContent = data.description;
    document.getElementById("moduleIcon").innerHTML = `<i class="fa-solid ${data.icon}"></i>`;
    const content = document.getElementById("moduleContent");
    content.innerHTML = `<div class="glass rounded-2xl p-6 text-center text-gray-400">Loading Advertisements...</div>`;
    import("/admin/js/modules/ads.js")
      .then(module => module.renderAdsModule(content))
      .catch(error => {
        console.error("Advertisements module error:", error);
        content.innerHTML = `<div class="glass rounded-2xl p-8 text-center text-red-400">Failed to load Advertisements module<div class="text-xs text-gray-500 mt-2">${error.message}</div></div>`;
      });
    return;
  }

  if (page === "videos") {

    dashboard.classList.add("hidden");
    module.classList.remove("hidden");

    document.getElementById("moduleTitle")
      .textContent = data.title;

    document.getElementById("moduleDescription")
      .textContent = data.description;

    document.getElementById("moduleIcon").innerHTML =
      `<i class="fa-solid ${data.icon}"></i>`;

    const content =
      document.getElementById("moduleContent");

    content.innerHTML = "";

    import("/admin/js/modules/videos.js")
      .then(module => module.renderVideosModule(content))
      .catch(error => {

        console.error(error);

        content.innerHTML = `
          <div class="glass rounded-2xl p-8 text-center text-red-400">
            Failed to load Video module.
            <div class="text-xs text-gray-500 mt-2">
              ${error.message}
            </div>
          </div>
        `;

      });

    return;
  }

  if (page === "matches") {
    dashboard.classList.add("hidden");
    module.classList.remove("hidden");

    document.getElementById("moduleTitle").textContent = data.title;
    document.getElementById("moduleDescription").textContent = data.description;
    document.getElementById("moduleIcon").innerHTML = `<i class="fa-solid ${data.icon}"></i>`;

    const content = document.getElementById("moduleContent");
    content.innerHTML = `<div class="glass rounded-2xl p-6 text-center text-gray-400">Loading Football Matches...</div>`;

    import("/admin/js/modules/matches.js")
      .then(module => {
        if (typeof module.renderMatchesModule === "function") {
          module.renderMatchesModule(content);
        } else if (typeof module.loadMatchesModule === "function") {
          module.loadMatchesModule(content);
        } else if (typeof module.init === "function") {
          module.init(content);
        } else {
          throw new Error("No Matches module renderer found.");
        }
      })
      .catch(error => {
        console.error("Matches module error:", error);
        content.innerHTML = `<div class="glass rounded-2xl p-8 text-center text-red-400"><div class="text-lg font-bold">Failed to load Matches module</div><div class="text-xs text-gray-500 mt-2">${error.message}</div></div>`;
      });

    return;
  }
  dashboard.classList.add("hidden");
  module.classList.remove("hidden");

  document.getElementById("moduleTitle")
    .textContent = data.title;

  document.getElementById("moduleDescription")
    .textContent = data.description;

  document.getElementById("moduleIcon").innerHTML =
    `<i class="fa-solid ${data.icon}"></i>`;

  document.getElementById("moduleContent").innerHTML = `

    <div class="grid md:grid-cols-3 gap-4">

      <div class="glass rounded-2xl p-5">
        <div class="text-xs text-gray-500">STATUS</div>
        <div class="font-bold text-green-400 mt-2">
          Ready
        </div>
      </div>

      <div class="glass rounded-2xl p-5">
        <div class="text-xs text-gray-500">MODULE</div>
        <div class="font-bold mt-2">
          ${data.title}
        </div>
      </div>

      <div class="glass rounded-2xl p-5">
        <div class="text-xs text-gray-500">ACCESS</div>
        <div class="font-bold text-green-400 mt-2">
          Authorized
        </div>
      </div>

    </div>

    <div class="glass rounded-2xl p-6 mt-5">

      <h3 class="font-black text-lg mb-2">
        ${data.title}
      </h3>

      <p class="text-gray-500 text-sm">
        This module is ready for Firebase-powered management.
      </p>

      <button
        class="mt-5 px-5 py-3 rounded-xl bg-green-500 text-black font-black text-sm"
        onclick="alert('Module setup coming next')">
        <i class="fa-solid fa-plus mr-2"></i>
        Create New
      </button>

    </div>
  `;

}


