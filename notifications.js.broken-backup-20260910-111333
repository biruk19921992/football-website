   NOTIFICATION ITEM
========================= */

function createNotificationItem(
  id,
  data
) {

  const item =
    document.createElement("div");

  const isRead =
    data.read === true;

  item.className =
    "px-4 py-4 border-b border-white/10 " +
    "hover:bg-white/5 transition " +
    (isRead ? "" : "bg-green-400/5");

  item.innerHTML = `

    <div class="flex gap-3">

      <div class="w-10 h-10 rounded-xl " +
        "bg-green-400/10 flex items-center " +
        "justify-center flex-shrink-0">

        <i class="fa-regular fa-bell text-green-400"></i>

      </div>

      <div class="min-w-0 flex-1">

        <div class="flex items-start justify-between gap-2">

          <h4 class="font-bold text-white text-sm">
            ${data.title || "Notification"}
          </h4>

          ${
            !isRead
              ? '<span class="w-2 h-2 bg-green-400 rounded-full mt-1 flex-shrink-0"></span>'
              : ""
          }

        </div>

        <p class="text-xs text-gray-400 mt-1">
          ${data.message || ""}
        </p>

      </div>

    </div>
  `;

  item.addEventListener(
    "click",
    async () => {

      if (!isRead && currentUser) {

        try {

          await update(
            ref(
              rtdb,
              `notifications/${currentUser.uid}/${id}`
            ),
            {
              read: true
            }
          );

        } catch (error) {

          console.error(
            "Notification read error:",
            error
          );
        }
      }
    }
  );

  return item;
}


   BADGE
========================= */

function updateBadge(count) {

  if (!notificationBtn) {
    return;
  }

  let badge =
    document.getElementById(
      "notificationBadge"
    );

  if (!badge) {

    badge =
      document.createElement("span");

    badge.id =
      "notificationBadge";

    badge.className =
      "absolute -top-1 -right-1 " +
      "min-w-[18px] h-[18px] px-1 " +
      "bg-red-500 text-white text-[10px] " +
      "font-bold rounded-full flex " +
      "items-center justify-center";

    notificationBtn.appendChild(badge);
  }

  if (count > 0) {

    badge.textContent =
      count > 99 ? "99+" : count;

    badge.classList.remove("hidden");

  } else {

    badge.classList.add("hidden");
  }
}


   RENDER
========================= */

function renderNotifications(data) {

  currentNotifications =
    data || {};

  if (!notificationList) {
    return;
  }

  notificationList.innerHTML = "";

  const entries =
    Object.entries(
      currentNotifications
    ).sort((a, b) => {

      const timeA =
        a[1].createdAt || 0;

      const timeB =
        b[1].createdAt || 0;

      return timeB - timeA;
    });

  if (entries.length === 0) {

    notificationList.innerHTML = `

      <div class="px-6 py-12 text-center text-gray-400">

        <i class="fa-regular fa-bell-slash text-3xl mb-3"></i>

        <p class="text-sm">
          No notifications yet
        </p>

      </div>
    `;

    updateBadge(0);

    return;
  }

  let unreadCount = 0;

  entries.forEach(
    ([id, data]) => {

      if (data.read !== true) {
        unreadCount++;
      }

      notificationList.appendChild(
        createNotificationItem(
          id,
          data
        )
      );
    }
  );

  updateBadge(
    unreadCount
  );
}


   PANEL
========================= */

if (notificationBtn) {

  notificationBtn.addEventListener(
    "click",
    (event) => {

      event.stopPropagation();

      if (notificationDropdown) {

        notificationDropdown.classList.toggle(
          "hidden"
        );
      }
    }
  );
}


document.addEventListener(
  "click",
  (event) => {

    if (
      notificationDropdown &&
      notificationBtn &&
      !notificationDropdown.contains(
        event.target
      ) &&
      !notificationBtn.contains(
        event.target
      )
    ) {

      notificationDropdown.classList.add(
        "hidden"
      );
    }
  }
);


   MARK ALL READ
========================= */

if (markAllReadBtn) {

  markAllReadBtn.addEventListener(
    "click",
    async () => {

      if (!currentUser) {
        return;
      }

      const updates = {};

      Object.keys(
        currentNotifications
      ).forEach(
        (id) => {

          updates[
            `notifications/${currentUser.uid}/${id}/read`
          ] = true;

        }
      );

      if (
        Object.keys(updates).length === 0
      ) {
        return;
      }

      try {

        await update(
          ref(rtdb),
          updates
        );

      } catch (error) {

        console.error(
          "Mark all read error:",
          error
        );
      }
    }
  );
}


   AUTH LISTENER
========================= */

watchAuth(
  (user) => {

    currentUser =
      user;

    window.currentFirebaseUser =
      user;


    if (!user) {

      if (notificationList) {

        notificationList.innerHTML = `

          <div class="px-6 py-12 text-center text-gray-400">

            <i class="fa-regular fa-bell-slash text-3xl mb-3"></i>

            <p class="text-sm">
              Login to see your notifications
            </p>

          </div>

        `;
      }

      updateBadge(0);

      return;
    }


       * REALTIME NOTIFICATIONS
    ========================= */

    const notificationsRef =
      ref(
        rtdb,
        `notifications/${user.uid}`
      );


    onValue(
      notificationsRef,
      (snapshot) => {

        renderNotifications(
          snapshot.val()
        );

      },
      (error) => {

        console.error(
          "Realtime Database error:",
          error
        );
      }
    );



  }
);
